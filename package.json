{
  "name": "progresstracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "glob": "^13.0.0"
  },
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_TURBOPACK=1 next dev",
    "build": "npx prisma generate && next build",
    "clean": "rimraf .next",
    "start": "next start",
    "lint": "eslint",
    "seed:test": "dotenv -e .env.local -- tsx src/scripts/seed-test-data.ts",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset",
    "diagrams:export:svg": "npx @mermaid-js/mermaid-cli -i .azure/architecture.mmd -o docs/architecture.svg",
    "diagrams:export:png": "npx @mermaid-js/mermaid-cli -i .azure/architecture.mmd -o docs/architecture.png",
    "diagrams:export:azure:svg": "npx @mermaid-js/mermaid-cli -i .azure/architecture-azure.mmd -o docs/architecture-azure.svg",
    "diagrams:export:azure:png": "npx @mermaid-js/mermaid-cli -i .azure/architecture-azure.mmd -o docs/architecture-azure.png",
    "diagrams:render-all": "npm run diagrams:export:svg && npm run diagrams:export:png && npm run diagrams:export:azure:svg && npm run diagrams:export:azure:png",
    "diagrams:watch": "chokidar \".azure/*.mmd\" -c \"npm run diagrams:render-all\""
  },
