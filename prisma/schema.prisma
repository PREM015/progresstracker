model Achievement {
  id String @id @default(cuid())

  // Identity
  slug        String @unique
  title       String @unique
  description String @db.Text

  // Classification
  category PlatformCategory
  tier     String           @default("bronze") // bronze, silver, gold, platinum, diamond

  // Display
  icon       String?
  color      String?
  badgeImage String?

