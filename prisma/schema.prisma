// ============================================================================
// GOALS & ACHIEVEMENTS
// ============================================================================

model Goal {
  id         String  @id @default(cuid())
  userId     String
  platformId String?

  title       String
  description String? @db.Text

  category     PlatformCategory
  goalType     GoalType         @default(CUSTOM)
  metric       GoalMetric       @default(PROBLEMS_SOLVED)
  customMetric String?

  target             Int
  progress           Int     @default(0)
  progressPercentage Float   @default(0)
  unit               String?

  startDate DateTime  @default(now())
  endDate   DateTime?
  deadline  DateTime?

  status      GoalStatus @default(ACTIVE)
  completedAt DateTime?
  failedAt    DateTime?

  milestones Json?

  currentStreakDays  Int  @default(0)
  requiredStreakDays Int?

  isPublic  Boolean @default(false)
  shareCode String? @unique

  reminderEnabled Boolean @default(false)

  daysActive       Int   @default(0)
  avgDailyProgress Float @default(0)
  bestDay          Json?

  color String?
  icon  String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)
  reminders GoalReminder[]
  history   GoalHistory[]

  @@index([userId])
  @@index([userId, status])
  @@index([category])
  @@index([deadline])
  @@index([shareCode])
  @@index([status])
  @@index([platformId])
  @@index([isPublic, status])
  @@index([deletedAt])
  // Performance indexes for sorting/filtering
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, status, deadline])
  @@index([userId, deadline])
}

model GoalReminder {
  id     String @id @default(cuid())
