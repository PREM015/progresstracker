  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(false)
  inAppEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  // Email Preferences
  emailAddress  String?
  emailVerified Boolean @default(false)

  // Notification Types
  achievementAlerts Boolean @default(true)
  goalReminders     Boolean @default(true)
  goalCompleted     Boolean @default(true)
  streakAlerts      Boolean @default(true)
  syncComplete      Boolean @default(false)
  syncFailed        Boolean @default(true)
  weeklyReport      Boolean @default(true)
  monthlyReport     Boolean @default(true)
  securityAlerts    Boolean @default(true)
  billingAlerts     Boolean @default(true)
  newFeatures       Boolean @default(true)
  tips              Boolean @default(true)
  communityUpdates  Boolean @default(false)
  marketingEmails   Boolean @default(false)

  // Quiet Hours
  quietHoursEnabled  Boolean @default(false)
  quietHoursStart    String  @default("22:00")
  quietHoursEnd      String  @default("08:00")
  quietHoursTimezone String  @default("UTC")

