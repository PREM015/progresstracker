  successCount Int       @default(0)
  failureCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([endpoint])
}

// ============================================================================
// SYNC & LOGS
// ============================================================================

model SyncLog {
  id             String  @id @default(cuid())
  userId         String
  platformId     String?
  userPlatformId String?

  // Status
  status SyncStatus

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // Milliseconds

  // Results
  itemsFound   Int @default(0)
  itemsCreated Int @default(0)
  itemsUpdated Int @default(0)
  itemsSkipped Int @default(0)
  itemsFailed  Int @default(0)

  // Data Range
  dataFromDate DateTime?
  dataToDate   DateTime?

  // Error Details
  hasError     Boolean @default(false)
  errorCode    String?
  errorMessage String? @db.Text
  errorStack   String? @db.Text

  // Retry Info
  attemptNumber Int       @default(1)
  maxAttempts   Int       @default(3)
  nextRetryAt   DateTime?

  // Trigger Info
  triggeredBy   String  @default("manual") // manual, scheduled, webhook, system
  triggerSource String?

  // Request Info
  requestId String?

  // Detailed Log
  // logEntries structure: [{ "timestamp": "...", "level": "info", "message": "..." }, ...]
  logEntries Json?

  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)
  userPlatform   UserPlatform?  @relation(fields: [userPlatformId], references: [id], onDelete: SetNull)
