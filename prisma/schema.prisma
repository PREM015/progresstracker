// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  // Type & Channel
  type     NotificationType
  channel  NotificationChannel  @default(IN_APP)
  priority NotificationPriority @default(NORMAL)

  // Content
  title        String
  message      String  @db.Text
  shortMessage String?

  // Action
  actionUrl   String?
  actionLabel String?

  // Related Entity
  entityType String? // goal, achievement, sync, etc.
  entityId   String?

  // Rich Content
  imageUrl String?
  // metadata structure: { "goalId": "...", "progress": 75, ... }
  metadata Json?

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  isDismissed Boolean   @default(false)
  dismissedAt DateTime?

  // Delivery
  isDelivered   Boolean   @default(false)
  deliveredAt   DateTime?
  deliveryError String?

  // Scheduling
