generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================
enum Role {
  user
  admin
}

enum PlatformCategory {
  DSA
  JOB
  GIT
  LEARNING
  HACKATHON
  OPENSOURCE
  COMPANY
  DESIGN
  DATA_SCIENCE
  OTHER
}

enum AuthType {
  NONE
  OAUTH
  API_KEY
  SCRAPING
  MANUAL
  HYBRID
}

enum SyncStatus {
  IDLE
  PENDING
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
  RATE_LIMITED
}

enum NotificationType {
  SYSTEM
  ACHIEVEMENT_UNLOCKED
  GOAL_REMINDER
  GOAL_COMPLETED
  GOAL_FAILED
  STREAK_AT_RISK
  STREAK_BROKEN
  STREAK_MILESTONE
  SYNC_COMPLETE
  SYNC_FAILED
  WEEKLY_REPORT
  MONTHLY_REPORT
  NEW_FEATURE
  SECURITY_ALERT
  BILLING_ALERT
  WELCOME
  REFERRAL
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
  CANCELLED
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
  STREAK
  MILESTONE
}

enum GoalMetric {
  PROBLEMS_SOLVED
  COMMITS
  PULL_REQUESTS
  PROJECTS_COMPLETED
  COURSES_COMPLETED
  CERTIFICATIONS
  APPLICATIONS_SUBMITTED
  CONTESTS_PARTICIPATED
  TIME_SPENT
  STREAK_DAYS
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
  UNPAID
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  TEAM
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ExportFormat {
  CSV
  JSON
  PDF
  EXCEL
  XML
}

enum ExportStatus {
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_CHANGE
  SETTINGS_CHANGE
  EXPORT_DATA
  IMPORT_DATA
  SYNC_TRIGGER
  SUBSCRIPTION_CHANGE
  API_KEY_CREATE
  API_KEY_DELETE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  ACCOUNT_DELETE
  ADMIN_ACTION
  WEBHOOK_TRIGGER
  SHARE_CREATE
  SHARE_ACCESS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShareEntityType {
  PROFILE
  ACHIEVEMENT
  GOAL
  REPORT
  STATS
  STREAK
  ACTIVITY
}

enum WebhookEventType {
  ENTRY_CREATED
  ENTRY_UPDATED
  ENTRY_DELETED
  GOAL_CREATED
  GOAL_COMPLETED
  GOAL_FAILED
  ACHIEVEMENT_UNLOCKED
  STREAK_MILESTONE
  STREAK_BROKEN
  SYNC_COMPLETED
  SYNC_FAILED
  SUBSCRIPTION_CHANGED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum ReferralRewardType {
  CREDITS
  SUBSCRIPTION_DAYS
  DISCOUNT_PERCENTAGE
  DISCOUNT_FIXED
  CASH
}

enum ReferralRewardStatus {
  PENDING
  EARNED
  PAID
  EXPIRED
  CANCELLED
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  COMPLAINED
}

// ============================================================================
// USER & AUTHENTICATION MODELS
// ============================================================================

model User {
  id String @id @default(cuid())

  // Basic Info
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  username      String?   @unique
  image         String?
  password      String?

  // Profile
  bio      String? @db.Text
  location String?
  website  String?
  company  String?
  jobTitle String?

  // Social Links
  githubUsername  String?
  linkedinUrl     String?
  twitterHandle   String?
  discordUsername String?

  // Profile Visibility
  isPublic         Boolean @default(false)
  showEmail        Boolean @default(false)
  showLocation     Boolean @default(true)
  showActivity     Boolean @default(true)
  showAchievements Boolean @default(true)
  showGoals        Boolean @default(false)
  showPlatforms    Boolean @default(true)
  showStreak       Boolean @default(true)

  // Account Status
  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)
  isBanned   Boolean   @default(false)
  banReason  String?
  bannedAt   DateTime?
  bannedBy   String?

  // Admin & Roles
  isAdmin     Boolean  @default(false)
  role        Role     @default(user)
  permissions String[] @default([])

  // Streak Data (denormalized for performance)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityDate   DateTime?
  streakStartDate    DateTime?
  streakFreezeCount  Int       @default(0)
  streakFreezeUsedAt DateTime?

  // Stats (denormalized for performance)
  totalProblems       Int  @default(0)
  totalCommits        Int  @default(0)
  totalProjects       Int  @default(0)
  totalCertifications Int  @default(0)
  totalAchievements   Int  @default(0)
  totalPoints         Int  @default(0)
  rank                Int?

  // Preferences
  preferredLanguage String @default("en")
  timezone          String @default("UTC")

  // Metadata
  signupSource String?
  referralCode String? @unique
  referredBy   String?

  // Onboarding
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingStep        Int       @default(0)

  // Timestamps
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([email, isActive], map: "idx_user_email_active_v1")
  @@index([username, isActive], map: "idx_user_username_active_v1")
  @@index([totalPoints(sort: Desc)], map: "idx_user_points_desc_v1")

  // ===== RELATIONS =====

  // Auth Relations
  accounts            Account[]
  sessions            Session[]
  activeSessions      ActiveSession[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  emailChangeRequests EmailChangeRequest[]
  twoFactorAuth       TwoFactorAuth?
  backupCodes         BackupCode[]
  loginAttempts       LoginAttempt[]

  // Platform Relations
  platforms       UserPlatform[]
  customPlatforms CustomPlatform[]

  // Tracking Relations
  trackerEntries TrackerEntry[]
  dailyStats     DailyStats[]
  streakHistory  StreakHistory[]

  // Goals & Achievements
  goals           Goal[]
  goalReminders   GoalReminder[]
  goalHistories   GoalHistory[]
  achievements    UserAchievement[]

  // Notifications
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // Billing
  subscription       Subscription?
  invoices           Invoice[]
  paymentMethods     PaymentMethod[]
  paymentEvents      PaymentEvent[]
  couponRedemptions  CouponRedemption[]

  // Export
  exportJobs       ExportJob[]
  scheduledExports ScheduledExport[]

  // Sync
  syncLogs SyncLog[]

  // Settings
  settings          UserSettings?
  notificationPrefs NotificationPreferences?

  // API & Security
  apiKeys   ApiKey[]
  auditLogs AuditLog[]
  webhooks  Webhook[]

  // Support
  supportTickets SupportTicket[]
  ticketReplies  TicketReply[]

  // Reports
  reports Report[]

  // Referrals
  referrals        User[]           @relation("Referrals")
  referrer         User?            @relation("Referrals", fields: [referredBy], references: [id], onDelete: SetNull)
  referrerRewards  ReferralReward[] @relation("ReferrerRewards")
  referredRewards  ReferralReward[] @relation("ReferredRewards")

  // Feedback
  feedback Feedback[]

  // Blog & Bookmarks
  bookmarks    Bookmark[]
  blogComments BlogComment[]
  blogLikes    BlogPostLike[]

  // Share Links
  shareLinks   ShareLink[]
  shareViews   ShareViewLog[]
  recentSearches RecentSearch[]

  @@index([email])
  @@index([username])
  @@index([isPublic])
  @@index([isActive])
  @@index([currentStreak], map: "idx_user_current_streak_v1")
  @@index([totalPoints], map: "idx_user_points_plain_v1")
  @@index([rank])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([referralCode])
  @@index([referredBy])
  @@index([deletedAt], map: "idx_user_deleted_at_v1")
  @@index([email, isActive], map: "idx_user_email_active_v2")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  // Additional OAuth data
  providerProfileUrl String?
  providerUsername   String?
  providerEmail      String?
  providerAvatar     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model ActiveSession {
  id     String @id @default(cuid())
  userId String

  token String @unique

  // Device Information
  userAgent      String? @db.Text
  ipAddress      String?
  device         String?
  deviceModel    String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?

  // Location (from IP)
  country     String?
  countryCode String?
  city        String?
  region      String?
  latitude    Float?
  longitude   Float?

  // Status
  isValid   Boolean @default(true)
  isCurrent Boolean @default(false)

  // Activity
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime

  // Security
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isValid])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@index([userId, isValid, expiresAt], name: "active_sessions_count_idx")
  @@index([lastActiveAt, isValid])
  @@index([userId, lastActiveAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String

  token  String @unique
  family String

  deviceId String?

  isValid Boolean @default(true)

  expiresAt DateTime

  revokedAt       DateTime?
  revokedReason   String?
  replacedByToken String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([isValid])
  @@index([expiresAt])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String

  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id     String @id @default(cuid())
  userId String

  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?

  type String @default("verification")

  verifiedIp String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
}

model EmailChangeRequest {
  id     String @id @default(cuid())
  userId String

  oldEmail String
  newEmail String

  oldEmailToken String @unique
  newEmailToken String @unique

  oldEmailVerified Boolean @default(false)
  newEmailVerified Boolean @default(false)

  expiresAt   DateTime
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldEmailToken])
  @@index([newEmailToken])
  @@index([expiresAt])
}

model TwoFactorAuth {
  id     String @id @default(cuid())
  userId String @unique

  secret String

  isEnabled Boolean @default(false)
  isPending Boolean @default(true)

  verifiedAt DateTime?
  lastUsedAt DateTime?

  recoveryEmail String?
  recoveryPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupCode {
  id     String @id @default(cuid())
  userId String

  code String

  usedAt        DateTime?
  usedIpAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model LoginAttempt {
  id     String  @id @default(cuid())
  userId String?

  email String

  success       Boolean
  failureReason String?

  ipAddress String?
  userAgent String? @db.Text
  country   String?

  twoFactorRequired Boolean @default(false)
  twoFactorPassed   Boolean @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
}

// ============================================================================
// PLATFORM MODELS
// ============================================================================

model Platform {
  id String @id @default(cuid())

  slug        String  @unique
  name        String
  displayName String?
  description String? @db.Text

  category    PlatformCategory
  subcategory String?
  tags        String[]         @default([])

  authType     AuthType @default(NONE)
  oauthConfig  Json?
  apiKeyConfig Json?

  icon            String?
  logo            String?
  color           String?
  backgroundColor String?

  website           String?
  apiEndpoint       String?
  profileUrlPattern String?

  supportsAutoSync    Boolean @default(false)
  supportsWebhook     Boolean @default(false)
  supportsOAuth       Boolean @default(false)
  supportsApiKey      Boolean @default(false)
  requiresCredentials Boolean @default(false)

  syncPriority Int @default(0)
  syncInterval Int @default(1440)

  rateLimit       Int?
  rateLimitWindow Int?

  dataPoints    Json?
  scraperConfig Json?

  isActive           Boolean @default(true)
  isVerified         Boolean @default(true)
  isBeta             Boolean @default(false)
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  lastHealthCheck DateTime?
  healthStatus    String?
  healthMessage   String?

  totalUsers      Int   @default(0)
  successRate     Float @default(100)
  avgSyncDuration Int?

  setupGuideUrl  String?
  helpArticleUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserPlatform[]
  trackerEntries TrackerEntry[]
  syncLogs       SyncLog[]
  platformStats  PlatformDailyStats[]
  goals          Goal[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
  @@index([supportsAutoSync])
}

model CustomPlatform {
  id     String @id @default(cuid())
  userId String

  name        String
  displayName String?
  description String? @db.Text

  category PlatformCategory

  icon    String?
  color   String?
  website String?

  trackingFields Json?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackerEntries TrackerEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
}

model UserPlatform {
  id         String @id @default(cuid())
  userId     String
  platformId String

  username       String?
  profileUrl     String?
  externalUserId String?

  credentials    Json?
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  apiKey String? @db.Text

  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  connectionStatus String  @default("pending")
  connectionError  String?

  syncStatus          SyncStatus @default(IDLE)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  lastSyncDuration    Int?
  syncAttempts        Int        @default(0)
  consecutiveFailures Int        @default(0)
  nextSyncAt          DateTime?

  cachedStats    Json?
  statsUpdatedAt DateTime?

  platformData Json?

  autoSync     Boolean @default(true)
  syncPriority Int     @default(0)

  notifyOnSync  Boolean @default(false)
  notifyOnError Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@unique([userId, platformId])
  @@index([userId])
  @@index([platformId])
  @@index([syncStatus])
  @@index([nextSyncAt])
  @@index([isActive])
  @@index([lastSyncedAt])
  @@index([userId, platformId, isActive])
  @@index([userId, syncStatus])
  @@index([userId, isActive])
  @@index([userId, updatedAt])
}

// ============================================================================
// TRACKING MODELS
// ============================================================================

model TrackerEntry {
  id               String  @id @default(cuid())
  userId           String
  platformId       String?
  customPlatformId String?

  date DateTime @db.Date

  category    PlatformCategory?
  subcategory String?

  problemsSolved    Int @default(0)
  problemsAttempted Int @default(0)

  easyProblems   Int @default(0)
  mediumProblems Int @default(0)
  hardProblems   Int @default(0)

  commits            Int @default(0)
  pullRequests       Int @default(0)
  pullRequestsMerged Int @default(0)
  issuesOpened       Int @default(0)
  issuesClosed       Int @default(0)
  codeReviews        Int @default(0)
  linesOfCode        Int @default(0)

  projectsStarted   Int @default(0)
  projectsCompleted Int @default(0)

  coursesStarted       Int @default(0)
  coursesCompleted     Int @default(0)
  lessonsCompleted     Int @default(0)
  modulesCompleted     Int @default(0)
  certificationsEarned Int @default(0)
  quizzesTaken         Int @default(0)
  quizzesPassed        Int @default(0)

  articlesRead       Int @default(0)
  tutorialsCompleted Int @default(0)
  documentationPages Int @default(0)

  applicationsSubmitted Int @default(0)
  applicationsViewed    Int @default(0)
  interviewsScheduled   Int @default(0)
  interviewsCompleted   Int @default(0)
  offersReceived        Int @default(0)

  contestsParticipated Int @default(0)
  contestsCompleted    Int @default(0)
  hackathonsJoined     Int @default(0)
  hackathonsCompleted  Int @default(0)

  mentoringSessions Int @default(0)
  helpGiven         Int @default(0)
  helpReceived      Int @default(0)
  postsWritten      Int @default(0)
  commentsWritten   Int @default(0)

  timeSpent Int @default(0)
  focusTime Int @default(0)

  averageDifficulty Float?
  accuracyRate      Float?
  completionRate    Float?

  rating       Int?
  ratingChange Int?
  rank         Int?
  rankChange   Int?
  points       Int?
  pointsEarned Int?
  streak       Int?
  xpEarned     Int?

  mood               String?
  energyLevel        Int?
  productivityRating Int?
  notes              String? @db.Text

  tags      String[] @default([])
  topics    String[] @default([])
  languages String[] @default([])

  source          String  @default("manual")
  syncLogId       String?
  isAutoGenerated Boolean @default(false)

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  customFields Json?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       Platform?       @relation(fields: [platformId], references: [id], onDelete: SetNull)
  customPlatform CustomPlatform? @relation(fields: [customPlatformId], references: [id], onDelete: SetNull)
  syncLog        SyncLog?        @relation(fields: [syncLogId], references: [id], onDelete: SetNull)

  @@unique([userId, platformId, date])
  @@index([userId])
  @@index([platformId])
  @@index([userId, createdAt], map: "tracker_user_created_idx")
  @@index([userId, date(sort: Desc)], map: "tracker_user_date_desc_idx") // Optimized for recent entries
  @@index([platformId, date])
  @@index([userId, category])
  @@index([userId, category, date])
  @@index([userId, platformId, date])
  @@index([source])
  @@index([date])
  @@index([customPlatformId])
  @@index([syncLogId])
  @@index([deletedAt])
  @@index([userId, date, problemsSolved], map: "tracker_user_date_problems_idx")
  @@index([userId, date], map: "tracker_user_date_idx_v2")
  @@index([userId, date, platformId])
}

model DailyStats {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  totalProblems     Int @default(0)
  totalCommits      Int @default(0)
  totalPullRequests Int @default(0)
  totalTimeSpent    Int @default(0)
  totalPoints       Int @default(0)

  platformBreakdown Json?
  categoryBreakdown Json?

  hadActivity Boolean @default(false)
  streakDay   Int?

  isComplete Boolean   @default(false)
  computedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([hadActivity])
  @@index([userId, hadActivity, date])
}

model StreakHistory {
  id     String @id @default(cuid())
  userId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  length Int

  isActive  Boolean @default(false)
  isCurrent Boolean @default(false)

  endReason String?

  totalProblems Int @default(0)
  totalCommits  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCurrent])
  @@index([length])
  @@index([startDate])
  @@index([userId, length(sort: Desc)]) // Optimized for finding longest streaks
}

model PlatformDailyStats {
  id         String   @id @default(cuid())
  platformId String
  date       DateTime @db.Date

  totalSyncs      Int @default(0)
  successfulSyncs Int @default(0)
  failedSyncs     Int @default(0)

  avgSyncDuration Int?

  activeUsers    Int @default(0)
  newConnections Int @default(0)

  createdAt DateTime @default(now())

