  // highlights structure: [{ "metric": "problems_solved", "value": 150, "change": 25 }, ...]
  highlights      Json?
  // insights structure: [{ "type": "streak", "message": "Your streak is on fire!" }, ...]
  insights        Json?
  // recommendations structure: [{ "action": "...", "reason": "..." }, ...]
  recommendations Json?

  // Status
  status String @default("generated") // generating, generated, sent, failed

  // Delivery
  sentAt DateTime?
  sentTo String?

  // File
  pdfUrl String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([periodStart])
  @@index([createdAt])
}

// ============================================================================
// SUPPORT & FEEDBACK
