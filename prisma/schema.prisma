generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================
enum Role {
  user
  admin
}

enum PlatformCategory {
  DSA
  JOB
  GIT
  LEARNING
  HACKATHON
  OPENSOURCE
  COMPANY
  DESIGN
  DATA_SCIENCE
  OTHER
}

enum AuthType {
  NONE
  OAUTH
  API_KEY
  SCRAPING
  MANUAL
  HYBRID
}

enum SyncStatus {
  IDLE
  PENDING
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
  RATE_LIMITED
}

enum NotificationType {
  SYSTEM
  ACHIEVEMENT_UNLOCKED
  GOAL_REMINDER
  GOAL_COMPLETED
  GOAL_FAILED
  STREAK_AT_RISK
  STREAK_BROKEN
  STREAK_MILESTONE
  SYNC_COMPLETE
  SYNC_FAILED
  WEEKLY_REPORT
  MONTHLY_REPORT
  NEW_FEATURE
  SECURITY_ALERT
  BILLING_ALERT
  WELCOME
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
  CANCELLED
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
  STREAK
  MILESTONE
}

enum GoalMetric {
  PROBLEMS_SOLVED
  COMMITS
  PULL_REQUESTS
  PROJECTS_COMPLETED
  COURSES_COMPLETED
  CERTIFICATIONS
  APPLICATIONS_SUBMITTED
  CONTESTS_PARTICIPATED
  TIME_SPENT
  STREAK_DAYS
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
  UNPAID
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  TEAM
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ExportFormat {
  CSV
  JSON
  PDF
  EXCEL
  XML
}

enum ExportStatus {
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_CHANGE
  SETTINGS_CHANGE
  EXPORT_DATA
  IMPORT_DATA
  SYNC_TRIGGER
  SUBSCRIPTION_CHANGE
  API_KEY_CREATE
  API_KEY_DELETE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  ACCOUNT_DELETE
  ADMIN_ACTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================================
// USER & AUTHENTICATION MODELS
// ============================================================================

model User {
  id String @id @default(cuid())

  // Basic Info
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  username      String?   @unique
  image         String?
  password      String? // Hashed password

  // Profile
  bio      String? @db.Text
  location String?
  website  String?
  company  String?
  jobTitle String?

  // Social Links
  githubUsername  String?
  linkedinUrl     String?
  twitterHandle   String?
  discordUsername String?

  // Profile Visibility
  isPublic         Boolean @default(false)
  showEmail        Boolean @default(false)
  showLocation     Boolean @default(true)
  showActivity     Boolean @default(true)
  showAchievements Boolean @default(true)
  showGoals        Boolean @default(false)
  showPlatforms    Boolean @default(true)
  showStreak       Boolean @default(true)

  // Account Status
  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)
  isBanned   Boolean   @default(false)
  banReason  String?
  bannedAt   DateTime?
  bannedBy   String?

  // Admin & Roles
  isAdmin     Boolean  @default(false)
  role        Role     @default(user) // user, admin
  permissions String[] @default([])

  // Streak Data (denormalized for performance)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityDate   DateTime?
  streakStartDate    DateTime?
  streakFreezeCount  Int       @default(0)
  streakFreezeUsedAt DateTime?

  // Stats (denormalized for performance)
  totalProblems       Int  @default(0)
  totalCommits        Int  @default(0)
  totalProjects       Int  @default(0)
  totalCertifications Int  @default(0)
  totalAchievements   Int  @default(0)
  totalPoints         Int  @default(0)
  rank                Int?

  // Preferences
  preferredLanguage String @default("en")
  timezone          String @default("UTC")

  // Metadata
  signupSource String? // organic, referral, google, etc.
  referralCode String? @unique
  referredBy   String?

  // Timestamps
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete

  // ===== RELATIONS =====

  // Auth Relations
  accounts            Account[]
  sessions            Session[]
  activeSessions      ActiveSession[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  emailChangeRequests EmailChangeRequest[]
  twoFactorAuth       TwoFactorAuth?
  backupCodes         BackupCode[]
  loginAttempts       LoginAttempt[]

  // Platform Relations
  platforms       UserPlatform[]
  customPlatforms CustomPlatform[]

  // Tracking Relations
  trackerEntries TrackerEntry[]
  dailyStats     DailyStats[]
  streakHistory  StreakHistory[]

  // Goals & Achievements
  goals         Goal[]
  goalReminders GoalReminder[]
  achievements  UserAchievement[]

  // Notifications
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // Billing
  subscription   Subscription?
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  paymentEvents  PaymentEvent[]

  // Export
  exportJobs       ExportJob[]
  scheduledExports ScheduledExport[]

  // Sync
  syncLogs SyncLog[]

  // Settings
  settings          UserSettings?
  notificationPrefs NotificationPreferences?

  // API & Security
  apiKeys   ApiKey[]
  auditLogs AuditLog[]

  // Support
  supportTickets SupportTicket[]
  ticketReplies  TicketReply[]

  // Reports (sent weekly/monthly)
  reports Report[]

  // Referrals
  referrals User[] @relation("Referrals")
  referrer  User?  @relation("Referrals", fields: [referredBy], references: [id], onDelete: SetNull)

  // Feedback
  feedback Feedback[]

  @@index([email])
  @@index([username])
  @@index([isPublic])
  @@index([isActive])
  @@index([currentStreak])
  @@index([totalPoints])
  @@index([rank])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([referralCode])
  @@index([referredBy])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  // Additional OAuth data
  providerProfileUrl String?
  providerUsername   String?
  providerEmail      String?
  providerAvatar     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model ActiveSession {
  id     String @id @default(cuid())
  userId String

  // Session Token
  token String @unique

  // Device Information
  userAgent      String? @db.Text
  ipAddress      String?
  device         String? // Desktop, Mobile, Tablet
  deviceModel    String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?

  // Location (from IP)
  country     String?
  countryCode String?
  city        String?
  region      String?
  latitude    Float?
  longitude   Float?

  // Status
  isValid   Boolean @default(true)
  isCurrent Boolean @default(false)

  // Activity
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime

  // Security
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isValid])
  @@index([expiresAt])
  @@index([lastActiveAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String

  token  String @unique
  family String // Token family for rotation

  // Device binding
  deviceId String?

  // Status
  isValid Boolean @default(true)

  // Expiry
  expiresAt DateTime

  // Revocation
  revokedAt       DateTime?
  revokedReason   String?
  replacedByToken String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([isValid])
  @@index([expiresAt])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String

  // Token should be hashed at application level before storing
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  // Security context
  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model EmailVerification {
  id     String @id @default(cuid())
  userId String

  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?

  // Type: initial verification or email change
  type String @default("verification") // verification, change

  // Optional: store IP address when verification occurs
  verifiedIp String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
}

model EmailChangeRequest {
  id     String @id @default(cuid())
  userId String

  oldEmail String
  newEmail String

  // Verification tokens
  oldEmailToken String @unique
  newEmailToken String @unique

  // Status
  oldEmailVerified Boolean @default(false)
  newEmailVerified Boolean @default(false)

  expiresAt   DateTime
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldEmailToken])
  @@index([newEmailToken])
  @@index([expiresAt])
}

model TwoFactorAuth {
  id     String @id @default(cuid())
  userId String @unique

  // TOTP Secret - MUST be encrypted at application level
  secret String

  // Status
  isEnabled Boolean @default(false)
  isPending Boolean @default(true) // Awaiting first verification

  // Verification
  verifiedAt DateTime?
  lastUsedAt DateTime?

  // Recovery
  recoveryEmail String?
  recoveryPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupCode {
  id     String @id @default(cuid())
  userId String

  // Hashed backup code - MUST be hashed at application level
  code String

  usedAt        DateTime?
  usedIpAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model LoginAttempt {
  id     String  @id @default(cuid())
  userId String? // Null if user not found

  email String

  // Result
  success       Boolean
  failureReason String? // invalid_password, account_locked, 2fa_failed, etc.

  // Context
  ipAddress String?
  userAgent String? @db.Text
  country   String?

  // 2FA
  twoFactorRequired Boolean @default(false)
  twoFactorPassed   Boolean @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
}

// ============================================================================
// PLATFORM MODELS
// ============================================================================

model Platform {
  id String @id @default(cuid())

  // Identity
  slug        String  @unique
  name        String
  displayName String?
  description String? @db.Text

  // Classification
  category    PlatformCategory
  subcategory String?
  tags        String[]         @default([])

  // Authentication
  authType     AuthType @default(NONE)
  oauthConfig  Json? // OAuth configuration if applicable
  apiKeyConfig Json? // API key configuration if applicable

  // Branding
  icon            String?
  logo            String?
  color           String?
  backgroundColor String?

  // URLs
  website           String?
  apiEndpoint       String?
  profileUrlPattern String? // e.g., "https://leetcode.com/{username}"

  // Capabilities
  supportsAutoSync    Boolean @default(false)
  supportsWebhook     Boolean @default(false)
  supportsOAuth       Boolean @default(false)
  supportsApiKey      Boolean @default(false)
  requiresCredentials Boolean @default(false)

  // Sync Configuration
  syncPriority Int @default(0)
  syncInterval Int @default(1440) // Minutes (default 24 hours)

  // Rate Limiting
  rateLimit       Int? // Requests per window
  rateLimitWindow Int? // Window in seconds

  // Data Configuration
  // dataPoints structure: { "problems_solved": true, "rating": true, "rank": true, ... }
  dataPoints    Json?
  // scraperConfig structure: { "selectors": {...}, "endpoints": [...], ... }
  scraperConfig Json?

  // Health & Status
  isActive           Boolean @default(true)
  isVerified         Boolean @default(true)
  isBeta             Boolean @default(false)
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  lastHealthCheck DateTime?
  healthStatus    String? // healthy, degraded, down, unknown
  healthMessage   String?

  // Stats
  totalUsers      Int   @default(0)
  successRate     Float @default(100)
  avgSyncDuration Int? // Milliseconds

  // Documentation
  setupGuideUrl  String?
  helpArticleUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users          UserPlatform[]
  trackerEntries TrackerEntry[]
  syncLogs       SyncLog[]
  platformStats  PlatformDailyStats[]
  goals          Goal[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
  @@index([supportsAutoSync])
}

model CustomPlatform {
  id     String @id @default(cuid())
  userId String

  // Basic Info
  name        String
  displayName String?
  description String? @db.Text

  category PlatformCategory

  // Branding
  icon    String?
  color   String?
  website String?

  // Tracking Configuration
  // trackingFields structure: { "problems": { "type": "number" }, "notes": { "type": "text" }, ... }
  trackingFields Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackerEntries TrackerEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
}

model UserPlatform {
  id         String @id @default(cuid())
  userId     String
  platformId String

  // Connection Info
  username       String?
  profileUrl     String?
  externalUserId String? // User ID on the platform

  // Credentials - MUST be encrypted at application level
  credentials    Json?
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  // API Key - MUST be encrypted at application level
  apiKey String? @db.Text

  // Status
  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // Connection Status
  connectionStatus String  @default("pending") // pending, connected, disconnected, error
  connectionError  String?

  // Sync Status
  syncStatus          SyncStatus @default(IDLE)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  lastSyncDuration    Int? // Milliseconds
  syncAttempts        Int        @default(0)
  consecutiveFailures Int        @default(0)
  nextSyncAt          DateTime?

  // Cached Stats (for quick display)
  // cachedStats structure: { "problems_solved": 150, "rating": 1800, ... }
  cachedStats    Json?
  statsUpdatedAt DateTime?

  // Platform-specific data
  // platformData structure: { "rating": 1800, "rank": "Expert", "contests": 25, ... }
  platformData Json?

  // Preferences
  autoSync     Boolean @default(true)
  syncPriority Int     @default(0)

  // Notification Settings
  notifyOnSync  Boolean @default(false)
  notifyOnError Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@unique([userId, platformId])
  @@index([userId])
  @@index([platformId])
  @@index([syncStatus])
  @@index([nextSyncAt])
  @@index([isActive])
  @@index([lastSyncedAt])
}

// ============================================================================
// TRACKING MODELS
// ============================================================================

model TrackerEntry {
  id               String  @id @default(cuid())
  userId           String
  platformId       String?
  customPlatformId String?

  date DateTime @db.Date

  // Classification
  category    PlatformCategory?
  subcategory String?

  // Primary Metrics
  problemsSolved    Int @default(0)
  problemsAttempted Int @default(0)

  easyProblems   Int @default(0)
  mediumProblems Int @default(0)
  hardProblems   Int @default(0)

  // Code & Development
  commits            Int @default(0)
  pullRequests       Int @default(0)
  pullRequestsMerged Int @default(0)
  issuesOpened       Int @default(0)
  issuesClosed       Int @default(0)
  codeReviews        Int @default(0)
  linesOfCode        Int @default(0)

  // Projects
  projectsStarted   Int @default(0)
  projectsCompleted Int @default(0)

  // Learning
  coursesStarted       Int @default(0)
  coursesCompleted     Int @default(0)
  lessonsCompleted     Int @default(0)
  modulesCompleted     Int @default(0)
  certificationsEarned Int @default(0)
  quizzesTaken         Int @default(0)
  quizzesPassed        Int @default(0)

  // Reading & Research
  articlesRead       Int @default(0)
  tutorialsCompleted Int @default(0)
  documentationPages Int @default(0)

  // Jobs & Applications
  applicationsSubmitted Int @default(0)
  applicationsViewed    Int @default(0)
  interviewsScheduled   Int @default(0)
  interviewsCompleted   Int @default(0)
  offersReceived        Int @default(0)

  // Competitions & Hackathons
  contestsParticipated Int @default(0)
  contestsCompleted    Int @default(0)
  hackathonsJoined     Int @default(0)
  hackathonsCompleted  Int @default(0)

  // Community
  mentoringSessions Int @default(0)
  helpGiven         Int @default(0)
  helpReceived      Int @default(0)
  postsWritten      Int @default(0)
  commentsWritten   Int @default(0)

  // Time Tracking
  timeSpent Int @default(0) // Minutes
  focusTime Int @default(0) // Minutes of focused work

  // Quality Metrics
  averageDifficulty Float?
  accuracyRate      Float?
  completionRate    Float?

  // Platform-specific
  rating       Int?
  ratingChange Int?
  rank         Int?
  rankChange   Int?
  points       Int?
  pointsEarned Int?
  streak       Int?
  xpEarned     Int?

  // Mood & Notes
  mood               String?
  energyLevel        Int? // 1-5
  productivityRating Int? // 1-5
  notes              String? @db.Text

  // Tags & Categories
  tags      String[] @default([])
  topics    String[] @default([])
  languages String[] @default([]) // Programming languages used

  // Source & Sync
  source          String  @default("manual") // manual, sync, import, api
  syncLogId       String?
  isAutoGenerated Boolean @default(false)

  // Verification
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // Custom Fields
  // customFields structure: { "fieldName": value, ... }
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       Platform?       @relation(fields: [platformId], references: [id], onDelete: SetNull)
  customPlatform CustomPlatform? @relation(fields: [customPlatformId], references: [id], onDelete: SetNull)
  syncLog        SyncLog?        @relation(fields: [syncLogId], references: [id], onDelete: SetNull)

  @@unique([userId, platformId, date])
  @@unique([userId, date, platformId], name: "userId_date_platformId")

  @@index([userId, date])
  @@index([platformId, date])
  @@index([userId, category])
  @@index([userId, category, date])
  @@index([source])
  @@index([date])
  @@index([customPlatformId])
  @@index([syncLogId])
}

model DailyStats {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  // Aggregated from all platforms
  totalProblems     Int @default(0)
  totalCommits      Int @default(0)
  totalPullRequests Int @default(0)
  totalTimeSpent    Int @default(0)
  totalPoints       Int @default(0)

  // Platform breakdown
  // platformBreakdown structure: { "leetcode": { "problems": 5 }, "github": { "commits": 10 }, ... }
  platformBreakdown Json?
  // categoryBreakdown structure: { "DSA": 15, "GIT": 10, ... }
  categoryBreakdown Json?

  // Streak
  hadActivity Boolean @default(false)
  streakDay   Int?

  // Computed at end of day
  isComplete Boolean   @default(false)
  computedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([hadActivity])
}

model StreakHistory {
  id     String @id @default(cuid())
  userId String

  // Streak period
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Length
  length Int

  // Status
  isActive  Boolean @default(false)
  isCurrent Boolean @default(false)

  // How it ended
  endReason String? // natural, broken, freeze_used

  // Stats during streak
  totalProblems Int @default(0)
  totalCommits  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCurrent])
  @@index([length])
  @@index([startDate])
}

model PlatformDailyStats {
  id         String   @id @default(cuid())
  platformId String
  date       DateTime @db.Date

  // Aggregate stats
  totalSyncs      Int @default(0)
  successfulSyncs Int @default(0)
  failedSyncs     Int @default(0)

  avgSyncDuration Int?

  activeUsers    Int @default(0)
  newConnections Int @default(0)

  createdAt DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, date])
  @@index([platformId])
  @@index([date])
}

// ============================================================================
// GOALS & ACHIEVEMENTS
// ============================================================================

model Goal {
  id         String  @id @default(cuid())
  userId     String
  platformId String?

  // Basic Info
  title       String
  description String? @db.Text

  // Classification
  category     PlatformCategory
  goalType     GoalType         @default(CUSTOM)
  metric       GoalMetric       @default(PROBLEMS_SOLVED)
  customMetric String?

  // Target
  target             Int
  progress           Int   @default(0)
  progressPercentage Float @default(0)
    unit               String?

  // Time Period
  startDate DateTime  @default(now())
  endDate   DateTime?
  deadline  DateTime?

  // Status
  status      GoalStatus @default(ACTIVE)
  completedAt DateTime?
  failedAt    DateTime?

  // Milestones
  // milestones structure: [{ "value": 25, "reached": true, "reachedAt": "2024-01-15" }, ...]
  milestones Json?

  // Streaks (for streak-type goals)
  currentStreakDays  Int  @default(0)
  requiredStreakDays Int?

  // Sharing
  isPublic  Boolean @default(false)
  shareCode String? @unique

  // Reminders
  reminderEnabled Boolean @default(false)

  // Stats
  daysActive       Int   @default(0)
  avgDailyProgress Float @default(0)
  // bestDay structure: { "date": "2024-01-15", "progress": 25 }
  bestDay          Json?

  // Color/Icon customization
  color String?
  icon  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)
  reminders GoalReminder[]

  @@index([userId])
  @@index([userId, status])
  @@index([category])
  @@index([deadline])
  @@index([shareCode])
  @@index([status])
  @@index([platformId])
}

model GoalReminder {
  id     String @id @default(cuid())
  goalId String
  userId String

