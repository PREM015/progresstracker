  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@index([nextSendAt])
  @@index([isActive])
}

model GoalTemplate {
  id String @id @default(cuid())

  title       String
  description String? @db.Text

  category PlatformCategory
  goalType GoalType
  metric   GoalMetric

  target   Int
  duration Int

  icon  String?
  color String?

  difficulty    String   @default("medium")
  estimatedTime String?
  tips          String[] @default([])

  timesUsed         Int    @default(0)
  successRate       Float  @default(0)
  avgCompletionTime Float?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@index([difficulty])
}

model GoalHistory {
  id     String @id @default(cuid())
  goalId String
  userId String

  // Snapshot of goal at change time
  data       Json
  changeType String // 'created', 'updated', 'status_changed', 'progress_updated', 'completed', 'failed'
  changedBy  String?

  // Previous values for specific field changes
  previousStatus   String?
  previousProgress Int?

  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@index([changeType])
  @@index([createdAt])
}

model Achievement {
  id String @id @default(cuid())

  slug        String @unique
  title       String @unique
  description String @db.Text

