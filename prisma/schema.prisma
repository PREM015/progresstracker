// ============================================================================
// API & SECURITY
// ============================================================================

model ApiKey {
  id     String @id @default(cuid())
  userId String

  // Key Info
  name        String
  description String?

  // Key Value (only prefix stored, full key shown once)
  keyHash   String @unique
  keyPrefix String // First 8 chars for display

  // Permissions
  scopes String[] @default(["read"]) // read, write, delete, admin

  // Rate Limiting
  rateLimit       Int @default(100) // Requests per minute
  rateLimitWindow Int @default(60) // Seconds

  // IP Restrictions
  allowedIps     String[] @default([])
  allowedOrigins String[] @default([])

  // Status
  isActive Boolean @default(true)

  // Expiry
  expiresAt DateTime?

  // Usage Stats
  lastUsedAt      DateTime?
  lastUsedIp      String?
  usageCount      Int       @default(0)
  usageCountDaily Int       @default(0)
  usageResetAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
  @@index([expiresAt])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  // Action
  action   AuditAction
  category String? // auth, user, platform, goal, etc.

  // Entity
  entityType String? // user, goal, platform, etc.
  entityId   String?

  // Details
  description String?
  oldValue    Json?
  newValue    Json?
  // changes structure: { "field": { "old": "...", "new": "..." }, ... }
  changes     Json?

  // Context
  ipAddress String?
  userAgent String? @db.Text

  // Location
  country String?
  city    String?

  // Request Info
  requestId     String?
  requestPath   String?
  requestMethod String?

  // Status
  status       String  @default("success") // success, failure
  errorMessage String?

  // Admin
  performedBy String? // Admin user ID if action by admin

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([category])
  @@index([userId, action, createdAt])
}

// ============================================================================
// REPORTS
// ============================================================================

model Report {
  id     String @id @default(cuid())
  userId String

  // Report Type
  type String // weekly, monthly, yearly, custom

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Content
  title   String
  summary String? @db.Text
  // data structure: { "stats": {...}, "charts": [...], "comparisons": {...} }
  data    Json

