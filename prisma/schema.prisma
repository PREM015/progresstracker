generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// ============================================================================
// ENUMS
// ============================================================================
enum Role {
  user
  admin
}

enum PlatformCategory {
  DSA
  JOB
  GIT
  LEARNING
  HACKATHON
  OPENSOURCE
  COMPANY
  DESIGN
  DATA_SCIENCE
  OTHER
}

enum AuthType {
  NONE
  OAUTH
  API_KEY
  SCRAPING
  MANUAL
  HYBRID
}

enum SyncStatus {
  IDLE
  PENDING
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
  RATE_LIMITED
}

enum NotificationType {
  SYSTEM
  ACHIEVEMENT_UNLOCKED
  GOAL_REMINDER
  GOAL_COMPLETED
  GOAL_FAILED
  STREAK_AT_RISK
  STREAK_BROKEN
  STREAK_MILESTONE
  SYNC_COMPLETE
  SYNC_FAILED
  WEEKLY_REPORT
  MONTHLY_REPORT
  NEW_FEATURE
  SECURITY_ALERT
  BILLING_ALERT
  WELCOME
  REFERRAL
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
  CANCELLED
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
  STREAK
  MILESTONE
}

enum GoalMetric {
  PROBLEMS_SOLVED
  COMMITS
  PULL_REQUESTS
  PROJECTS_COMPLETED
  COURSES_COMPLETED
  CERTIFICATIONS
  APPLICATIONS_SUBMITTED
  CONTESTS_PARTICIPATED
  TIME_SPENT
  STREAK_DAYS
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
  UNPAID
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  TEAM
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ExportFormat {
  CSV
  JSON
  PDF
  EXCEL
  XML
}

enum ExportStatus {
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_CHANGE
  SETTINGS_CHANGE
  EXPORT_DATA
  IMPORT_DATA
  SYNC_TRIGGER
  SUBSCRIPTION_CHANGE
  API_KEY_CREATE
  API_KEY_DELETE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  ACCOUNT_DELETE
  ADMIN_ACTION
  WEBHOOK_TRIGGER
  SHARE_CREATE
  SHARE_ACCESS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShareEntityType {
  PROFILE
  ACHIEVEMENT
  GOAL
  REPORT
  STATS
  STREAK
  ACTIVITY
}

enum WebhookEventType {
  ENTRY_CREATED
  ENTRY_UPDATED
  ENTRY_DELETED
  GOAL_CREATED
  GOAL_COMPLETED
  GOAL_FAILED
  ACHIEVEMENT_UNLOCKED
  STREAK_MILESTONE
  STREAK_BROKEN
  SYNC_COMPLETED
  SYNC_FAILED
  SUBSCRIPTION_CHANGED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum ReferralRewardType {
  CREDITS
  SUBSCRIPTION_DAYS
  DISCOUNT_PERCENTAGE
  DISCOUNT_FIXED
  CASH
}

enum ReferralRewardStatus {
  PENDING
  EARNED
  PAID
  EXPIRED
  CANCELLED
}

enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  COMPLAINED
}

// ============================================================================
// USER & AUTHENTICATION MODELS
// ============================================================================

model User {
  id String @id @default(cuid())

  // Basic Info
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  username      String?   @unique
  image         String?
  password      String?

  // Profile
  bio      String? @db.Text
  location String?
  website  String?
  company  String?
  jobTitle String?

  // Social Links
  githubUsername  String?
  linkedinUrl     String?
  twitterHandle   String?
  discordUsername String?

  // Profile Visibility
  isPublic         Boolean @default(false)
  showEmail        Boolean @default(false)
  showLocation     Boolean @default(true)
  showActivity     Boolean @default(true)
  showAchievements Boolean @default(true)
  showGoals        Boolean @default(false)
  showPlatforms    Boolean @default(true)
  showStreak       Boolean @default(true)

  // Account Status
  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)
  isBanned   Boolean   @default(false)
  banReason  String?
  bannedAt   DateTime?
  bannedBy   String?

  // Admin & Roles
  isAdmin     Boolean  @default(false)
  role        Role     @default(user)
  permissions String[] @default([])

  // Streak Data (denormalized for performance)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityDate   DateTime?
  streakStartDate    DateTime?
  streakFreezeCount  Int       @default(0)
  streakFreezeUsedAt DateTime?

  // Stats (denormalized for performance)
  totalProblems       Int  @default(0)
  totalCommits        Int  @default(0)
  totalProjects       Int  @default(0)
  totalCertifications Int  @default(0)
  totalAchievements   Int  @default(0)
  totalPoints         Int  @default(0)
  rank                Int?

  // Preferences
  preferredLanguage String @default("en")
  timezone          String @default("UTC")

  // Metadata
  signupSource String?
  referralCode String? @unique
  referredBy   String?

  // Onboarding
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingStep        Int       @default(0)

  // Timestamps
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // ===== RELATIONS =====
  accounts            Account[]
  sessions            Session[]
  activeSessions      ActiveSession[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  emailChangeRequests EmailChangeRequest[]
  twoFactorAuth       TwoFactorAuth?
  backupCodes         BackupCode[]
  loginAttempts       LoginAttempt[]
  platforms           UserPlatform[]
  customPlatforms     CustomPlatform[]
  trackerEntries      TrackerEntry[]
  dailyStats          DailyStats[]
  streakHistory       StreakHistory[]
  goals               Goal[]
  goalReminders       GoalReminder[]
  goalHistories       GoalHistory[]
  achievements        UserAchievement[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  subscription        Subscription?
  invoices            Invoice[]
  paymentMethods      PaymentMethod[]
  paymentEvents       PaymentEvent[]
  couponRedemptions   CouponRedemption[]
  exportJobs          ExportJob[]
  scheduledExports    ScheduledExport[]
  syncLogs            SyncLog[]
  settings            UserSettings?
  notificationPrefs   NotificationPreferences?
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  webhooks            Webhook[]
  supportTickets      SupportTicket[]
  ticketReplies       TicketReply[]
  reports             Report[]
  referrals           User[]           @relation("Referrals")
  referrer            User?            @relation("Referrals", fields: [referredBy], references: [id], onDelete: SetNull)
  referrerRewards     ReferralReward[] @relation("ReferrerRewards")
  referredRewards     ReferralReward[] @relation("ReferredRewards")
  feedback            Feedback[]
  bookmarks           Bookmark[]
  blogComments        BlogComment[]
  blogLikes           BlogPostLike[]
  shareLinks          ShareLink[]
  shareViews          ShareViewLog[]
  recentSearches      RecentSearch[]

  // ===== INDEXES =====
  @@index([email])
  @@index([username])
  @@index([isPublic])
  @@index([isActive])
  @@index([rank])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([referralCode])
  @@index([referredBy])
  @@index([email, isActive], map: "idx_user_email_active")
  @@index([username, isActive], map: "idx_user_username_active")
  @@index([totalPoints(sort: Desc)], map: "idx_user_points_desc")
  @@index([currentStreak(sort: Desc)], map: "idx_user_current_streak_desc")
  @@index([longestStreak(sort: Desc)], map: "idx_user_longest_streak_desc")
  @@index([deletedAt], map: "idx_user_deleted_at")
  @@index([isBanned], map: "idx_user_is_banned")
  @@index([role], map: "idx_user_role")
  @@index([role, isActive], map: "idx_user_role_active")
  @@index([onboardingCompleted], map: "idx_user_onboarding_completed")
  @@index([isVerified], map: "idx_user_is_verified")
  @@index([isPublic, isActive, totalPoints(sort: Desc)], map: "idx_user_leaderboard")
  @@index([signupSource], map: "idx_user_signup_source")
  @@index([lastLoginAt], map: "idx_user_last_login_at")
  @@index([isActive, isBanned], map: "idx_user_active_banned")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  providerProfileUrl String?
  providerUsername   String?
  providerEmail      String?
  providerAvatar     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([providerEmail], map: "idx_account_provider_email")
  @@index([providerUsername], map: "idx_account_provider_username")
  @@index([userId, provider], map: "idx_account_user_provider")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model ActiveSession {
  id             String    @id @default(cuid())
  userId         String
  token          String    @unique
  userAgent      String?   @db.Text
  ipAddress      String?
  device         String?
  deviceModel    String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  country        String?
  countryCode    String?
  city           String?
  region         String?
  latitude       Float?
  longitude      Float?
  isValid        Boolean   @default(true)
  isCurrent      Boolean   @default(false)
  lastActiveAt   DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isValid])
  @@index([expiresAt])
  @@index([lastActiveAt])
  @@index([userId, isValid, expiresAt], map: "idx_active_session_user_valid_expires")
  @@index([lastActiveAt, isValid], map: "idx_active_session_last_active_valid")
  @@index([userId, lastActiveAt], map: "idx_active_session_user_last_active")
  @@index([ipAddress], map: "idx_active_session_ip_address")
  @@index([userId, isCurrent], map: "idx_active_session_user_current")
  @@index([revokedAt], map: "idx_active_session_revoked_at")
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique
  family          String
  deviceId        String?
  isValid         Boolean   @default(true)
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  replacedByToken String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@index([isValid])
  @@index([expiresAt])
  @@index([deviceId], map: "idx_refresh_token_device_id")
  @@index([userId, isValid], map: "idx_refresh_token_user_valid")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([usedAt], map: "idx_password_reset_used_at")
  @@index([ipAddress], map: "idx_password_reset_ip_address")
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  type       String    @default("verification")
  verifiedIp String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@index([token, type], map: "idx_email_verification_token_type")
  @@index([userId, type, verifiedAt], map: "idx_email_verification_user_type_verified")
  @@index([verifiedAt], map: "idx_email_verification_verified_at")
  @@index([type], map: "idx_email_verification_type")
}

model EmailChangeRequest {
  id               String    @id @default(cuid())
  userId           String
  oldEmail         String
  newEmail         String
  oldEmailToken    String    @unique
  newEmailToken    String    @unique
  oldEmailVerified Boolean   @default(false)
  newEmailVerified Boolean   @default(false)
  expiresAt        DateTime
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldEmailToken])
  @@index([newEmailToken])
  @@index([expiresAt])
  @@index([completedAt], map: "idx_email_change_completed_at")
  @@index([newEmail], map: "idx_email_change_new_email")
}

model TwoFactorAuth {
  id            String    @id @default(cuid())
  userId        String    @unique
  secret        String
  isEnabled     Boolean   @default(false)
  isPending     Boolean   @default(true)
  verifiedAt    DateTime?
  lastUsedAt    DateTime?
  recoveryEmail String?
  recoveryPhone String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled], map: "idx_two_factor_is_enabled")
  @@index([isPending], map: "idx_two_factor_is_pending")
}

model BackupCode {
  id            String    @id @default(cuid())
  userId        String
  code          String
  usedAt        DateTime?
  usedIpAddress String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([userId, usedAt], map: "idx_backup_code_user_used_at")
}

model LoginAttempt {
  id                String   @id @default(cuid())
  userId            String?
  email             String
  success           Boolean
  failureReason     String?
  ipAddress         String?
  userAgent         String?  @db.Text
  country           String?
  twoFactorRequired Boolean  @default(false)
  twoFactorPassed   Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
  @@index([userId, createdAt(sort: Desc)], map: "idx_login_attempt_user_created_desc")
  @@index([email, createdAt(sort: Desc)], map: "idx_login_attempt_email_created_desc")
  @@index([email, success, createdAt], map: "idx_login_attempt_email_success_time")
  @@index([ipAddress, success, createdAt], map: "idx_login_attempt_ip_success_time")
  @@index([country, createdAt], map: "idx_login_attempt_country_time")
}

// ============================================================================
// PLATFORM MODELS
// ============================================================================

model Platform {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  displayName         String?
  description         String?          @db.Text
  category            PlatformCategory
  subcategory         String?
  tags                String[]         @default([])
  authType            AuthType         @default(NONE)
  oauthConfig         Json?
  apiKeyConfig        Json?
  icon                String?
  logo                String?
  color               String?
  backgroundColor     String?
  website             String?
  apiEndpoint         String?
  profileUrlPattern   String?
  supportsAutoSync    Boolean          @default(false)
  supportsWebhook     Boolean          @default(false)
  supportsOAuth       Boolean          @default(false)
  supportsApiKey      Boolean          @default(false)
  requiresCredentials Boolean          @default(false)
  syncPriority        Int              @default(0)
  syncInterval        Int              @default(1440)
  rateLimit           Int?
  rateLimitWindow     Int?
  dataPoints          Json?
  scraperConfig       Json?
  isActive            Boolean          @default(true)
  isVerified          Boolean          @default(true)
  isBeta              Boolean          @default(false)
  maintenanceMode     Boolean          @default(false)
  maintenanceMessage  String?
  lastHealthCheck     DateTime?
  healthStatus        String?
  healthMessage       String?
  totalUsers          Int              @default(0)
  successRate         Float            @default(100)
  avgSyncDuration     Int?
  setupGuideUrl       String?
  helpArticleUrl      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  users          UserPlatform[]
  trackerEntries TrackerEntry[]
  syncLogs       SyncLog[]
  platformStats  PlatformDailyStats[]
  goals          Goal[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
  @@index([supportsAutoSync])
  @@index([category, isActive], map: "idx_platform_category_active")
  @@index([isBeta], map: "idx_platform_is_beta")
  @@index([maintenanceMode], map: "idx_platform_maintenance_mode")
  @@index([healthStatus], map: "idx_platform_health_status")
  @@index([authType], map: "idx_platform_auth_type")
  @@index([isVerified], map: "idx_platform_is_verified")
  @@index([totalUsers(sort: Desc)], map: "idx_platform_total_users_desc")
}

model CustomPlatform {
  id             String           @id @default(cuid())
  userId         String
  name           String
  displayName    String?
  description    String?          @db.Text
  category       PlatformCategory
  icon           String?
  color          String?
  website        String?
  trackingFields Json?
  isActive       Boolean          @default(true)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackerEntries TrackerEntry[]

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@index([userId, isActive], map: "idx_custom_platform_user_active")
  @@index([userId, category], map: "idx_custom_platform_user_category")
}

model UserPlatform {
  id                  String     @id @default(cuid())
  userId              String
  platformId          String
  username            String?
  profileUrl          String?
  externalUserId      String?
  credentials         Json?
  accessToken         String?    @db.Text
  refreshToken        String?    @db.Text
  tokenExpiresAt      DateTime?
  apiKey              String?    @db.Text
  isActive            Boolean    @default(true)
  isVerified          Boolean    @default(false)
  verifiedAt          DateTime?
  connectionStatus    String     @default("pending")
  connectionError     String?
  syncStatus          SyncStatus @default(IDLE)
  lastSyncedAt        DateTime?
  lastSyncError       String?
  lastSyncDuration    Int?
  syncAttempts        Int        @default(0)
  consecutiveFailures Int        @default(0)
  nextSyncAt          DateTime?
  cachedStats         Json?
  statsUpdatedAt      DateTime?
  platformData        Json?
  autoSync            Boolean    @default(true)
  syncPriority        Int        @default(0)
  notifyOnSync        Boolean    @default(false)
  notifyOnError       Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@unique([userId, platformId])
  @@index([userId])
  @@index([platformId])
  @@index([syncStatus])
  @@index([nextSyncAt])
  @@index([isActive])
  @@index([lastSyncedAt])
  @@index([userId, platformId, isActive], map: "idx_user_platform_user_platform_active")
  @@index([userId, syncStatus], map: "idx_user_platform_user_sync_status")
  @@index([userId, isActive], map: "idx_user_platform_user_active")
  @@index([userId, updatedAt], map: "idx_user_platform_user_updated")
  @@index([userId, platformId, syncStatus], map: "idx_user_platform_user_platform_sync")
  @@index([autoSync, syncStatus], map: "idx_user_platform_autosync_status")
  @@index([tokenExpiresAt], map: "idx_user_platform_token_expires_at")
  @@index([connectionStatus], map: "idx_user_platform_connection_status")
  @@index([consecutiveFailures], map: "idx_user_platform_consecutive_failures")
  @@index([platformId, isActive], map: "idx_user_platform_platform_active")
  @@index([autoSync, nextSyncAt], map: "idx_user_platform_autosync_next")
  @@index([isVerified], map: "idx_user_platform_is_verified")
}

// ============================================================================
// TRACKING MODELS
// ============================================================================

model TrackerEntry {
  id                    String            @id @default(cuid())
  userId                String
  platformId            String?
  customPlatformId      String?
  date                  DateTime          @db.Date
  category              PlatformCategory?
  subcategory           String?
  problemsSolved        Int               @default(0)
  problemsAttempted     Int               @default(0)
  easyProblems          Int               @default(0)
  mediumProblems        Int               @default(0)
  hardProblems          Int               @default(0)
  commits               Int               @default(0)
  pullRequests          Int               @default(0)
  pullRequestsMerged    Int               @default(0)
  issuesOpened          Int               @default(0)
  issuesClosed          Int               @default(0)
  codeReviews           Int               @default(0)
  linesOfCode           Int               @default(0)
  projectsStarted       Int               @default(0)
  projectsCompleted     Int               @default(0)
  coursesStarted        Int               @default(0)
  coursesCompleted      Int               @default(0)
  lessonsCompleted      Int               @default(0)
  modulesCompleted      Int               @default(0)
  certificationsEarned  Int               @default(0)
  quizzesTaken          Int               @default(0)
  quizzesPassed         Int               @default(0)
  articlesRead          Int               @default(0)
  tutorialsCompleted    Int               @default(0)
  documentationPages    Int               @default(0)
  applicationsSubmitted Int               @default(0)
  applicationsViewed    Int               @default(0)
  interviewsScheduled   Int               @default(0)
  interviewsCompleted   Int               @default(0)
  offersReceived        Int               @default(0)
  contestsParticipated  Int               @default(0)
