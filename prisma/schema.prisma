  points   Int    @default(0)
  xpReward Int    @default(0)
  rarity   String @default("common") // common, uncommon, rare, epic, legendary

  // Requirements
  // requirement structure: { "type": "problems_solved", "value": 100, "platform": "leetcode" }
  requirement     Json?
  requirementText String?

  // Thresholds for progress
  // thresholds structure: [{ "value": 25, "label": "Bronze" }, { "value": 50, "label": "Silver" }, ...]
  thresholds Json?

  // Hidden Achievements
