  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model Feedback {
  id     String  @id @default(cuid())
  userId String?

  // Type
  type String // bug, feature, improvement, other

  // Content
  title   String?
  message String  @db.Text

  // Rating
  rating Int? // 1-5

  // Context
  page      String?
  userAgent String?

  // Status
  status String @default("new") // new, reviewed, planned, implemented, declined

  // Response
  response    String?   @db.Text
  respondedAt DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// WAITLIST & NEWSLETTER
// ============================================================================

model Waitlist {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  // Source
  source       String? // landing, blog, referral, etc.
  referralCode String?

  // Status
  status String @default("waiting") // waiting, invited, joined

  // Invite
  invitedAt  DateTime?
  inviteCode String?
  joinedAt   DateTime?

  // Position
  position Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  // Preferences
  topics    String[] @default([])
  frequency String   @default("weekly") // weekly, monthly

  // Status
  isActive          Boolean   @default(true)
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?

  // Token for unsubscribe
  unsubscribeToken String @unique @default(cuid())

  // Stats
  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  emailsClicked Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model FeatureFlag {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?

  // Status
  isEnabled Boolean @default(false)

  // Targeting
  enabledForAll     Boolean            @default(false)
  enabledUserIds    String[]           @default([])
  enabledTiers      SubscriptionTier[] @default([])
  enabledPercentage Int                @default(0)

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([isEnabled])
}

model SystemSettings {
  id String @id @default(cuid())

  key   String @unique
  value Json

  description String?
  category    String?

  isPublic Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
  @@index([category])
}

model MaintenanceWindow {
  id String @id @default(cuid())

  title   String
  message String @db.Text

  startTime DateTime
  endTime   DateTime

  isActive         Boolean  @default(false)
  affectedServices String[] @default([])

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startTime])
  @@index([endTime])
}

// ============================================================================
// BLOG (If needed)
// ============================================================================

model BlogPost {
  id String @id @default(cuid())

  // Content
  slug    String  @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text

  // Media
  featuredImage String?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Classification
  category String?
  tags     String[] @default([])

  // Author
  authorId   String?
  authorName String?

  // Status
  status      String    @default("draft") // draft, published, archived
  publishedAt DateTime?

  // Stats
  viewCount Int @default(0)
  likeCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([category])
}

// ============================================================================
// CHANGELOG
// ============================================================================

model ChangelogEntry {
  id String @id @default(cuid())

  version     String
  title       String
  description String @db.Text

  // Type
  type String // feature, improvement, bugfix, security

  // Content
  // changes structure: [{ "type": "added", "description": "..." }, ...]
  changes Json

  // Status
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([version])
  @@index([isPublished])
  @@index([publishedAt])
}
