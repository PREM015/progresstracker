// ========================================
// Prisma Schema – Progress Tracker (Phase-1)
// ========================================
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * ENUMS (Phase-1 Locked)
 * =========================
 */

enum PlatformCategory {
  DSA
  JOB
  GIT
  LEARNING
  HACKATHON
  OPENSOURCE
  COMPANY
  OTHER
}

enum AuthType {
  NONE
  OAUTH
  API
  SCRAPING
  MANUAL
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

/**
 * =========================
 * USER MANAGEMENT
 * =========================
 */
model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  username String? @unique
  image    String?
  password String?
  bio      String?
  location String?
  website  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  platforms      UserPlatform[]
  trackerEntries TrackerEntry[]
  goals          Goal[]
  achievements   UserAchievement[]
  syncLogs       SyncLog[]

  settings      UserSettings?
  notifications NotificationPreferences?

  @@index([email])
  @@index([username])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * =========================
 * PLATFORMS
 * =========================
 */

model Platform {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  displayName String?
  description String?

  category PlatformCategory
  authType AuthType         @default(NONE)

  icon        String?
  color       String?
  website     String?
  apiEndpoint String?

  supportsAutoSync Boolean @default(false)

  // Defines what metrics a platform provides
  dataPoints Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserPlatform[]
  trackerEntries TrackerEntry[]
  syncLogs       SyncLog[]

  @@index([category])
}

/**
 * =========================
 * USER ↔ PLATFORM
 * =========================
 */

model UserPlatform {
  id         String @id @default(cuid())
  userId     String
  platformId String

  username     String?
  credentials  Json?
  isActive     Boolean    @default(true)
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([userId, platformId])
  @@index([userId])
  @@index([platformId])
}

/**
 * =========================
 * TRACKER (CORE ANALYTICS)
 * =========================
 */

model TrackerEntry {
  id         String   @id @default(cuid())
  userId     String
  platformId String?
  date       DateTime @db.Date // daily aggregation

  // Stored for historical accuracy
  category PlatformCategory?

  problemsSolved        Int @default(0)
  projectsCompleted     Int @default(0)
  applicationsSubmitted Int @default(0)
  coursesCompleted      Int @default(0)
  timeSpent             Int @default(0) // minutes

  mood  String?
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  // One entry per user + platform + day
  @@unique([userId, platformId, date])
  // Fast dashboard queries
  @@index([userId, date])
  @@index([platformId, date])
}

/**
 * =========================
 * GOALS & ACHIEVEMENTS
 * =========================
 */

model Goal {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String? @db.Text

  category PlatformCategory
  target   Int
  progress Int              @default(0)

  status      String    @default("active") // Phase-1 string (enum later)
  deadline    DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model Achievement {
  id          String           @id @default(cuid())
  title       String           @unique
  description String
  category    PlatformCategory
  icon        String?
  points      Int              @default(0)

  createdAt DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

/**
 * =========================
 * SYNC LOGS
 * =========================
 */

model SyncLog {
  id         String  @id @default(cuid())
  userId     String
  platformId String?

  status   SyncStatus
  message  String?    @db.Text
  duration Int? // ms

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platformId])
}

/**
 * =========================
 * USER PREFERENCES
 * =========================
 */

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  theme         String  @default("system")
  language      String  @default("en")
  timezone      String  @default("UTC")
  dateFormat    String  @default("MM/DD/YYYY")
  autoSync      Boolean @default(true)
  syncFrequency String  @default("daily")
  publicProfile Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(false)
  weeklyReport       Boolean @default(true)
  dailyReminder      Boolean @default(false)
  goalReminders      Boolean @default(true)
  achievementAlerts  Boolean @default(true)
  syncFailures       Boolean @default(true)
  newFeatures        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
