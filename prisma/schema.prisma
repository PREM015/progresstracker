// ============================================================================
// WEBHOOKS
// ============================================================================

model Webhook {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?

  // Webhook configuration
  url        String
  secret     String
  httpMethod String @default("POST")
  headers    Json?

  // Events to trigger
  events WebhookEventType[] @default([])

  // Filtering
  filters Json? // e.g., { platformId: 'xxx', category: 'DSA' }

  // Status
  isActive Boolean @default(true)

  // Retry configuration
  maxRetries   Int @default(3)
  retryDelayMs Int @default(1000)
  timeoutMs    Int @default(30000)

  // Stats
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?

  // Error tracking
  consecutiveFailures Int       @default(0)
  lastError           String?
  disabledAt          DateTime?
  disabledReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
}

model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String

  // Event info
  event   WebhookEventType
  payload Json

  // Request details
  requestUrl     String
  requestHeaders Json?
  requestBody    String? @db.Text

  // Response
  status         WebhookDeliveryStatus @default(PENDING)
  responseCode   Int?
  responseBody   String?               @db.Text
  responseTimeMs Int?

  // Error handling
  errorMessage  String?
  attemptNumber Int       @default(1)
  nextRetryAt   DateTime?

  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
  @@index([nextRetryAt])
}

// ============================================================================
// SHARE & EMBED
// ============================================================================

model ShareLink {
  id     String @id @default(cuid())
  userId String

  code String @unique

  // What's being shared
  entityType ShareEntityType
  entityId   String?

  // Share configuration
  title       String?
  description String?

  // Visibility settings
  isPublic      Boolean  @default(true)
  requiresAuth  Boolean  @default(false)
  allowedEmails String[] @default([])

  // Access control
  password  String?
  expiresAt DateTime?
  maxViews  Int?

  // Analytics
  viewCount       Int       @default(0)
  uniqueViewCount Int       @default(0)
  lastViewedAt    DateTime?

  // Embed settings
  allowEmbed   Boolean @default(true)
  embedTheme   String  @default("auto") // 'light', 'dark', 'auto'
  embedSize    String  @default("medium") // 'small', 'medium', 'large'
  showBranding Boolean @default(true)
  customStyles Json?

  // Status
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewLogs ShareViewLog[]

  @@index([userId])
  @@index([code])
  @@index([entityType, entityId])
  @@index([isActive])
  @@index([expiresAt])
}

model ShareViewLog {
  id          String @id @default(cuid())
  shareLinkId String

  // Viewer info
  viewerUserId String?
  ipHash       String?
  userAgent    String? @db.Text

  // Location
  country String?
  city    String?

  // Referrer
  referrer String?

  // Embed info
  isEmbed   Boolean @default(false)
  embedHost String?

  createdAt DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  viewer    User?     @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([shareLinkId])
  @@index([viewerUserId])
  @@index([createdAt])
}

// ============================================================================
// EMAIL TEMPLATES & LOGS
// ============================================================================

model EmailTemplate {
  id String @id @default(cuid())

  slug        String @unique
  name        String
  description String?

  // Template content
  subject     String
  htmlContent String @db.Text
  textContent String? @db.Text

  // Template variables
  variables   String[] @default([]) // e.g., ['userName', 'resetLink']
  defaultData Json?

  // Categorization
  category String // 'auth', 'notification', 'marketing', 'transactional', 'report'

  // Status
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // System templates can't be deleted

  // Version control
  version         Int    @default(1)
  previousVersion String?

  // Usage stats
  sentCount  Int       @default(0)
  lastSentAt DateTime?

  // Preview
  previewData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  emailLogs EmailLog[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
}

model EmailLog {
  id String @id @default(cuid())

  templateId String?
  userId     String?

  // Email details
  to           String
  cc           String[] @default([])
  bcc          String[] @default([])
  subject      String
  templateSlug String?

  // Status
  status EmailLogStatus @default(QUEUED)

  // Provider info
  provider   String? // 'resend', 'sendgrid', etc.
  providerId String? // External message ID

  // Tracking
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  failedAt    DateTime?

  // Engagement
  openCount  Int @default(0)
  clickCount Int @default(0)

  // Error handling
  errorCode    String?
  errorMessage String?
  retryCount   Int       @default(0)
  nextRetryAt  DateTime?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
  @@index([to])
  @@index([providerId])
}

// ============================================================================
// REPORTS
// ============================================================================

model Report {
  id     String @id @default(cuid())
  userId String

  type String

  periodStart DateTime
  periodEnd   DateTime

  title   String
  summary String? @db.Text
  data    Json

  highlights      Json?
  insights        Json?
  recommendations Json?

  status String @default("generated")

  sentAt DateTime?
  sentTo String?

  pdfUrl String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([periodStart])
  @@index([createdAt])
}

// ============================================================================
// SUPPORT & FEEDBACK
// ============================================================================

model SupportTicket {
  id     String @id @default(cuid())
  userId String

  ticketNumber String @unique
  subject      String
  description  String @db.Text

  category String
  priority TicketPriority @default(MEDIUM)

  status TicketStatus @default(OPEN)

  assignedTo String?

  resolution String?   @db.Text
  resolvedAt DateTime?

  metadata    Json?
  attachments String[] @default([])

  satisfactionRating Int?
  feedbackComment    String?

  // SLA tracking
  firstResponseAt  DateTime?
  firstResponseSla Int? // minutes
  resolutionSla    Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([assignedTo])
}

model TicketReply {
  id       String  @id @default(cuid())
  ticketId String
  userId   String?

  message String @db.Text

  isStaffReply Boolean @default(false)
  isAutoReply  Boolean @default(false)

  attachments String[] @default([])

  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model Feedback {
  id     String  @id @default(cuid())
  userId String?

  type String

  title   String?
  message String  @db.Text

  rating Int?

  page       String?
  userAgent  String?
  screenshot String? // URL to screenshot

  status String @default("new")

  response    String?   @db.Text
  respondedAt DateTime?
  respondedBy String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// KNOWLEDGE BASE
// ============================================================================

model KnowledgeBaseCategory {
  id String @id @default(cuid())

  slug        String  @unique
  name        String
  description String?
  icon        String?

  parentId String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   KnowledgeBaseCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeBaseCategory[] @relation("SubCategories")
  articles KnowledgeBaseArticle[]

  @@index([parentId])
  @@index([isActive])
  @@index([slug])
}

model KnowledgeBaseArticle {
  id String @id @default(cuid())

  slug    String @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text

  categoryId String

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status
  status      String    @default("draft") // 'draft', 'published', 'archived'
  publishedAt DateTime?

  // Engagement
  viewCount  Int @default(0)
  helpfulYes Int @default(0)
  helpfulNo  Int @default(0)

  // Related
  relatedArticleIds String[] @default([])
  tags              String[] @default([])

  // Featured
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  // Author
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category KnowledgeBaseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([isFeatured])
  @@index([publishedAt])
}

// ============================================================================
// WAITLIST & NEWSLETTER
// ============================================================================

model Waitlist {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  source       String?
  referralCode String?
  referredById String?

  status String @default("waiting")

  invitedAt  DateTime?
  inviteCode String?   @unique
  joinedAt   DateTime?

  position Int?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([inviteCode])
  @@index([position])
}

model NewsletterSubscriber {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  topics    String[] @default([])
  frequency String   @default("weekly")

  isActive          Boolean   @default(true)
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?

  unsubscribeToken String @unique @default(cuid())
  confirmToken     String? @unique

  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  emailsClicked Int @default(0)

  source   String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([unsubscribeToken])
  @@index([confirmToken])
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model FeatureFlag {
  id String @id @default(cuid())

  key         String  @unique
  name        String
  description String?

  isEnabled Boolean @default(false)

  enabledForAll     Boolean            @default(false)
  enabledUserIds    String[]           @default([])
  enabledTiers      SubscriptionTier[] @default([])
  enabledPercentage Int                @default(0)

  // Targeting rules
  rules Json?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([isEnabled])
}

model SystemSettings {
  id String @id @default(cuid())

  key   String @unique
  value Json

  description String?
  category    String?

  isPublic  Boolean @default(false)
  isSecret  Boolean @default(false)
  encrypted Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
  @@index([category])
  @@index([isPublic])
}

model MaintenanceWindow {
  id String @id @default(cuid())

  title   String
  message String @db.Text

  startTime DateTime
  endTime   DateTime

  isActive         Boolean  @default(false)
  affectedServices String[] @default([])
  severity         String   @default("partial") // 'full', 'partial', 'degraded'

  allowedIps    String[] @default([])
  bypassSecrets String[] @default([])

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startTime])
  @@index([endTime])
}

// ============================================================================
// BLOG
// ============================================================================

model BlogPost {
  id String @id @default(cuid())

  slug    String  @unique
  title   String
  excerpt String? @db.Text
  content String  @db.Text

  authorId   String?
  authorName String?

  category String?
  tags     String[] @default([])

  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  status      String    @default("draft")
  publishedAt DateTime?

  isFeatured       Boolean @default(false)
  allowComments    Boolean @default(true)
  showTableOfContents Boolean @default(true)

  // Reading time
  readingTimeMinutes Int?
  wordCount          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments BlogComment[]
  likes    BlogPostLike[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@index([isFeatured])
}

model BlogComment {
  id String @id @default(cuid())

  postId   String
  authorId String
  parentId String?

  content String @db.Text

  likes Int @default(0)

  isApproved Boolean @default(true)
  isDeleted  Boolean @default(false)
  isPinned   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("Replies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([isApproved])
}

model BlogPostLike {
  id String @id @default(cuid())

  postId String
  userId String?
  ipHash String?

  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, userId])
  @@unique([postId, ipHash])
  @@index([postId])
}

// ============================================================================
// CHANGELOG
// ============================================================================

model ChangelogEntry {
  id String @id @default(cuid())

  version     String
  title       String
  description String @db.Text

  type String // 'feature', 'improvement', 'bugfix', 'security', 'deprecation'

  changes Json

  // Links
  pullRequestUrl String?
  issueUrl       String?
  docsUrl        String?

  // Media
  imageUrl String?
  videoUrl String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  isBreaking  Boolean   @default(false)
  isFeatured  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([version])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([type])
}

// ============================================================================
// BOOKMARK
// ============================================================================

model Bookmark {
  id String @id @default(cuid())

  userId     String
  entityType String
  entityId   String

  title String?
  notes String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType])
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}