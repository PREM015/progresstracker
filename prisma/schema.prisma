  category KnowledgeBaseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([status, publishedAt(sort: Desc)], map: "idx_kb_article_status_published_at")
  @@index([categoryId, status], map: "idx_kb_article_category_status")
  @@index([authorId], map: "idx_kb_article_author_id")
  @@index([viewCount(sort: Desc)], map: "idx_kb_article_view_count_desc")
  @@index([isFeatured, status, sortOrder], map: "idx_kb_article_featured_status_sort")
}

// ============================================================================
// WAITLIST & NEWSLETTER
// ============================================================================

model Waitlist {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  source       String?
  referralCode String?
  referredById String?
  status       String    @default("waiting")
  invitedAt    DateTime?
  inviteCode   String?   @unique
  joinedAt     DateTime?
  position     Int?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([inviteCode])
  @@index([position])
  @@index([status, position], map: "idx_waitlist_status_position")
  @@index([source], map: "idx_waitlist_source")
  @@index([referredById], map: "idx_waitlist_referred_by_id")
  @@index([invitedAt, joinedAt], map: "idx_waitlist_invited_joined")
}

model NewsletterSubscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  topics            String[]  @default([])
  frequency         String    @default("weekly")
  isActive          Boolean   @default(true)
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  unsubscribeToken  String    @unique @default(cuid())
  confirmToken      String?   @unique
  emailsSent        Int       @default(0)
  emailsOpened      Int       @default(0)
  emailsClicked     Int       @default(0)
  source            String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([unsubscribeToken])
  @@index([confirmToken])
  @@index([isActive, frequency], map: "idx_newsletter_active_frequency")
  @@index([confirmedAt, isActive], map: "idx_newsletter_confirmed_active")
  @@index([source], map: "idx_newsletter_source")
  @@index([emailsOpened(sort: Desc)], map: "idx_newsletter_emails_opened_desc")
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model FeatureFlag {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String
  description       String?
  isEnabled         Boolean            @default(false)
  enabledForAll     Boolean            @default(false)
  enabledUserIds    String[]           @default([])
  enabledTiers      SubscriptionTier[] @default([])
  enabledPercentage Int                @default(0)
  rules             Json?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([key])
  @@index([isEnabled])
  @@index([isEnabled, enabledForAll], map: "idx_feature_flag_enabled_for_all")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String?
  isPublic    Boolean  @default(false)
  isSecret    Boolean  @default(false)
  encrypted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
  @@index([category])
  @@index([isPublic])
  @@index([isPublic, category], map: "idx_system_settings_public_category")
  @@index([isSecret], map: "idx_system_settings_is_secret")
}

model MaintenanceWindow {
  id               String   @id @default(cuid())
  title            String
  message          String   @db.Text
  startTime        DateTime
  endTime          DateTime
  isActive         Boolean  @default(false)
  affectedServices String[] @default([])
  severity         String   @default("partial")
  allowedIps       String[] @default([])
  bypassSecrets    String[] @default([])
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([startTime])
  @@index([endTime])
  @@index([isActive, startTime, endTime], map: "idx_maintenance_window_active_range")
  @@index([severity, isActive], map: "idx_maintenance_window_severity_active")
}

// ============================================================================
// BLOG
// ============================================================================

model BlogPost {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  excerpt             String?   @db.Text
  content             String    @db.Text
  authorId            String?
  authorName          String?
  category            String?
  tags                String[]  @default([])
  featuredImage       String?
  metaTitle           String?
  metaDescription     String?
  metaKeywords        String[]  @default([])
  viewCount           Int       @default(0)
  likeCount           Int       @default(0)
  commentCount        Int       @default(0)
  shareCount          Int       @default(0)
  status              String    @default("draft")
  publishedAt         DateTime?
  isFeatured          Boolean   @default(false)
  allowComments       Boolean   @default(true)
  showTableOfContents Boolean   @default(true)
  readingTimeMinutes  Int?
  wordCount           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  comments BlogComment[]
  likes    BlogPostLike[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@index([status, publishedAt(sort: Desc)], map: "idx_blogpost_status_published_desc")
  @@index([category, status, publishedAt(sort: Desc)], map: "idx_blogpost_category_status_published")
  @@index([isFeatured, status, publishedAt(sort: Desc)], map: "idx_blogpost_featured_status_published")
  @@index([authorId, status, publishedAt(sort: Desc)], map: "idx_blogpost_author_status_published")
  @@index([viewCount(sort: Desc)], map: "idx_blog_post_view_count_desc")
  @@index([likeCount(sort: Desc)], map: "idx_blog_post_like_count_desc")
  @@index([tags], map: "idx_blog_post_tags", type: Gin)
}

model BlogComment {
  id         String    @id @default(cuid())
  postId     String
  authorId   String
  parentId   String?
  content    String    @db.Text
  likes      Int       @default(0)
  isApproved Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("Replies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([isApproved])
  @@index([postId, isApproved, createdAt], map: "idx_blog_comment_post_approved_time")
  @@index([postId, isPinned], map: "idx_blog_comment_post_pinned")
  @@index([isDeleted, postId], map: "idx_blog_comment_deleted_post")
  @@index([postId, parentId, createdAt], map: "idx_blog_comment_post_parent_time")
}

model BlogPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  ipHash    String?
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, userId])
  @@unique([postId, ipHash])
  @@index([postId])
  @@index([userId, createdAt], map: "idx_blog_post_like_user_created_at")
}

// ============================================================================
// CHANGELOG
// ============================================================================

model ChangelogEntry {
  id             String    @id @default(cuid())
  version        String
  title          String
  description    String    @db.Text
  type           String
  changes        Json
  pullRequestUrl String?
  issueUrl       String?
  docsUrl        String?
  imageUrl       String?
  videoUrl       String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  isBreaking     Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([version])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([type])
  @@index([isPublished, publishedAt(sort: Desc)], map: "idx_changelog_published_at_desc")
  @@index([isBreaking, isPublished], map: "idx_changelog_breaking_published")
  @@index([type, isPublished], map: "idx_changelog_type_published")
  @@index([isFeatured, isPublished], map: "idx_changelog_featured_published")
}

// ============================================================================
// BOOKMARK
// ============================================================================

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  title      String?
  notes      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType])
  @@index([userId, entityType], map: "idx_bookmark_user_entity_type")
  @@index([userId, createdAt], map: "idx_bookmark_user_created_at")
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)], map: "idx_recent_search_user_created_desc")
  @@index([query], map: "idx_recent_search_query")
}
