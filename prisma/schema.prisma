// ============================================================================
// BILLING & SUBSCRIPTION
// ============================================================================

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?
  stripeProductId      String?

  tier            SubscriptionTier   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  billingInterval BillingInterval    @default(MONTHLY)

  priceAmount Int?
  currency    String @default("usd")

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  trialStart DateTime?
  trialEnd   DateTime?
  trialDays  Int?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelAt          DateTime?
  canceledAt        DateTime?
  cancelReason      String?
  cancelFeedback    String?   @db.Text

  pausedAt  DateTime?
  resumesAt DateTime?

  platformLimit        Int @default(5)
  syncFrequencyMinutes Int @default(1440)
  exportLimitMonthly   Int @default(3)
  apiRequestsDaily     Int @default(100)

  currentPlatformCount Int       @default(0)
  currentExportCount   Int       @default(0)
  usageResetAt         DateTime?

  features String[] @default([])

  lastPaymentAt     DateTime?
  lastPaymentAmount Int?
  nextPaymentAt     DateTime?

  // Applied coupon
  appliedCouponId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  paymentEvents PaymentEvent[]
  appliedCoupon Coupon?        @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([tier])
  @@index([appliedCouponId])
}

model PaymentMethod {
  id     String @id @default(cuid())
  userId String

  stripePaymentMethodId String @unique

  type     String
  brand    String?
  last4    String?
  expMonth Int?
  expYear  Int?

  isDefault Boolean @default(false)
  isValid   Boolean @default(true)

  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model Invoice {
  id             String  @id @default(cuid())
  userId         String
  subscriptionId String?

  stripeInvoiceId       String? @unique
  stripePaymentIntentId String?

  invoiceNumber String?

  subtotal   Int
  tax        Int    @default(0)
  total      Int
  amountPaid Int    @default(0)
  amountDue  Int
  currency   String @default("usd")

  status String

  invoiceDate DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?

  lineItems Json?

  invoicePdfUrl    String?
  hostedInvoiceUrl String?

  billingReason String?

  // Discount applied
  discountAmount Int?
  couponId       String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([stripeInvoiceId])
  @@index([stripePaymentIntentId])
  @@index([invoiceDate])
}

model PaymentEvent {
  id             String  @id @default(cuid())
  userId         String?
  subscriptionId String?

  stripeEventId   String @unique
  stripeEventType String

  eventType String
  status    PaymentStatus

  amount   Int?
  currency String?

  failureCode    String?
  failureMessage String?

  stripePaymentIntentId String?
  stripeInvoiceId       String?
  stripeChargeId        String?

  rawData Json?

  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subscriptionId])
  @@index([stripeEventId])
  @@index([stripePaymentIntentId])
  @@index([stripeInvoiceId])
  @@index([stripeChargeId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id String @id @default(cuid())

  code        String @unique
  name        String
  description String?

  // Discount configuration
  discountType  CouponDiscountType
  discountValue Int // Percentage (0-100) or amount in cents
  currency      String             @default("usd")

  // Applicability
  applicableTiers SubscriptionTier[] @default([])
  applicablePlans String[]           @default([]) // Stripe price IDs

  // Duration
  duration       CouponDuration @default(ONCE)
  durationMonths Int?

  // Limits
  maxRedemptions        Int? // Total max redemptions
  maxRedemptionsPerUser Int  @default(1)
  currentRedemptions    Int  @default(0)

  // Validity period
  validFrom  DateTime @default(now())
  validUntil DateTime?

  // Minimum requirements
  minimumAmount Int? // Minimum order amount in cents

  // Status
  isActive Boolean @default(true)

  // Stripe integration
  stripeCouponId String? @unique

  // Tracking
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions   CouponRedemption[]
  subscriptions Subscription[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
  @@index([stripeCouponId])
}

model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  userId   String

  // Order/subscription info
  subscriptionId String?
  invoiceId      String?

  // Discount applied
  discountAmount Int
  currency       String

  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, subscriptionId])
  @@index([couponId])
  @@index([userId])
  @@index([redeemedAt])
}

// ============================================================================
// REFERRAL SYSTEM
// ============================================================================

model ReferralReward {
  id String @id @default(cuid())

  // Referrer (who shared the code)
  referrerId String

  // Referred user
  referredId String

  // Reward details
  type   String               @default("signup") // 'signup', 'subscription', 'milestone'
  status ReferralRewardStatus @default(PENDING)

  // Reward value
  rewardType     ReferralRewardType
  rewardValue    Int // Amount of credits, days, percentage, or cents
  rewardCurrency String?

  // Conditions
  qualifyingAction String? // What action triggered the reward
  qualifiedAt      DateTime?

  // Payout (for cash rewards)
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?

  // Expiry
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredRewards", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId, type])
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

