  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([tier])
  @@index([appliedCouponId])
  @@index([tier, status], map: "idx_subscription_tier_status")
  @@index([currentPeriodEnd], map: "idx_subscription_current_period_end")
  @@index([trialEnd, status], map: "idx_subscription_trial_end_status")
  @@index([cancelAtPeriodEnd, currentPeriodEnd], map: "idx_subscription_cancel_at_period")
  @@index([nextPaymentAt, status], map: "idx_subscription_next_payment_status")
  @@index([resumesAt, status], map: "idx_subscription_resumes_at_status")
  @@index([billingInterval, status], map: "idx_subscription_billing_interval_status")
}

