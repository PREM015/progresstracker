graph TD
  %% Azure-target topology variant

  subgraph Compute
    direction TB
    WebApp["Next.js web app\n(src/app)\nFrontend + API routes (Vercel or App Service)"]
    TriggerFunctions["Background tasks (Trigger.dev -> Azure Functions)\n(src/trigger)\nServerless functions for quick ops"]
    ScrapersAKS["Scrapers & background workers\n(src/services/scrapers)\nAKS cluster (scalable workers)"]
  end

  subgraph Data
    Postgres["Azure Database for PostgreSQL\n(Prisma as ORM)"]
    Redis["Azure Cache for Redis\n(Bull queues)"]
    Storage["Azure Storage (Blob)\nObject storage for exports & uploads"]
    OAuth["OAuth providers / External APIs\n(GitHub, Google, LinkedIn, etc.)"]
  end

  WebApp --> |"hosted on"| WebApp
  WebApp --> |"reads/writes"| Postgres
  WebApp --> |"queues jobs"| Redis
  WebApp --> |"uploads/reads files"| Storage
  WebApp --> |"auth / OAuth"| OAuth

  TriggerFunctions --> |"reads/writes"| Postgres
  TriggerFunctions --> |"uses queues (Redis)"| Redis
  TriggerFunctions --> |"stores files"| Storage

  ScrapersAKS --> |"calls external platforms"| OAuth
  ScrapersAKS --> |"writes results"| Postgres
  ScrapersAKS --> |"enqueue/consume"| Redis

  subgraph Observability
    AppInsights["Application Insights / Sentry\nMonitoring & traces"]
  end

  WebApp --> AppInsights
  TriggerFunctions --> AppInsights
  ScrapersAKS --> AppInsights

  classDef infra fill:#e0f7ff,stroke:#333,stroke-width:1px;
  class Postgres,Redis,Storage,OAuth,AppInsights infra
