⚠️ Install a Mermaid preview extension in your editor to render the diagram.

```mermaid
graph TD
	%% Full project architecture

	%% Compute services (user-facing + background)
	subgraph Compute
		direction TB
		WebApp["Next.js web app\n(src/app)\nFrontend + API routes (Vercel / App Service)"]
		TriggerTasks["Trigger.dev tasks & scheduled workflows\n(src/trigger)\nBackground runtime (Container Apps)"]
		Scrapers["Scrapers & background workers\n(src/services/scrapers)\nContainer Apps / Workers"]
	end

	%% CI/CD and tests
	subgraph CI
		GHAction["GitHub Actions\n(.github/workflows)\nCI, E2E (Playwright), build & deploy"]
	end

	%% Data & dependency services
	subgraph Data
		Postgres["PostgreSQL (Prisma)\nPrimary relational DB"]
		Redis["Redis (Bull)\nQueueing & cache"]
		ObjectStore["Object Storage (AWS S3)\nUploads, exports, artefacts"]
		ExternalAPIs["External platforms\n(GitHub, LinkedIn, OAuth, etc.)"]
	end

	%% Hosting/Service mesh
	Vercel["Vercel (hosting + cron)\nserves Next.js, cron endpoints"]

	%% Relationships & flows
	WebApp --> |"hosted on"| Vercel
	WebApp --> |"reads/writes (secrets)"| Postgres
	WebApp --> |"queues jobs"| Redis
	WebApp --> |"uploads/reads files"| ObjectStore
	WebApp --> |"auth / OAuth"| ExternalAPIs

	TriggerTasks --> |"reads/writes"| Postgres
	TriggerTasks --> |"queues & processes"| Redis
	TriggerTasks --> |"stores files"| ObjectStore
	TriggerTasks --> |"calls external APIs / scrapers"| ExternalAPIs

	Scrapers --> |"calls external platforms"| ExternalAPIs
	Scrapers --> |"stores results"| Postgres
	Scrapers --> |"enqueue work / use queues"| Redis

	GHAction -.-> |"runs tests / deploys"| Vercel
	GHAction -.-> |"e2e tests"| WebApp

	%% Optional monitoring / logging notes
	subgraph Observability
		AppInsights["Monitoring / logging (Sentry / App Insights)\nFront / Back / Tasks"]
	end

	WebApp --> AppInsights
	TriggerTasks --> AppInsights
	Scrapers --> AppInsights

	classDef infra fill:#f9f,stroke:#333,stroke-width:1px;
	class Postgres,Redis,ObjectStore,ExternalAPIs,AppInsights infra

```
